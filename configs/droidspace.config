# Kernel configurations for DroidSpaces on the Pulsar base
# (branch staging-bpf, kernel 4.19.404)
# Diferencas vs a config da base:
#   - MGLRU portado para esta base (patches/mglru/0001-mglru.patch),
#     com CONFIG_LRU_GEN y + CONFIG_LRU_GEN_ENABLED y (default ligado em runtime)
#   - zram default compressor via CONFIG_ZRAM_DEF_COMP (mecanismo da base)
# KernelSU-Next (submodule rsuntk/KernelSU), ntsync e BPF a16/a17
# ja sao nativos nesta base.

# IPC mechanisms
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# Seccomp support
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups support
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# MEMCG: habilitado (patches/memcg). O mm/memcontrol.c 4.19 so usa
# memcg->css.cgroup/cgroup_ino() - campos que o graft 5.10 preserva; a quebra
# real do port estava em FAIR_GROUP_SCHED (p->__state) e CGROUP_NET_PRIO
# (css->cgroup->id), corrigidas pelos patches abaixo. Exigido pelo
# CONFIG_DOCKER (LXC/Kosminor) e pelo lmkd userspace (memory.current/max).
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
# FAIR_GROUP_SCHED: task_change_group_fair() usava p->__state (nome 5.x);
# com o patch 0001 (p->state, TASK_NEW ja existe no sched.h graftado)
# compila. Exigido por CONFIG_DOCKER (LXC) e pela controladora cpu.weight.
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
# CGROUP_NET_PRIO: netprio_cgroup.c usava css->cgroup->id (struct cgroup::id
# removido pelo graft 5.x); o patch 0002 troca para css->id (como o mainline
# v5.6). Exigido por CONFIG_DOCKER (LXC) para net_prio.ifmap.
CONFIG_CGROUP_NET_PRIO=y

# ---- LXC / Docker support (completo) ----
# Mapeado do Kconfig "CONFIG_DOCKER" de tomxi1997/lxc-docker-support-for-android
# (seletores validados contra os Kconfig da base e404; simbolos inexistentes
# na base - AUFS_FS, NF_CONNMARK_IPV4, DEVPTS_MULTIPLE_INSTANCES,
# RESOURCE_COUNTERS - foram omitidos).
# Cgroups adicionais (CPU RT, perf, net_cls)
# CGROUP_HUGETLB/HUGETLBFS desligados explicitamente: mm/hugetlb.c nao
# compila nesta base (graft 5.x parcial; a propria defconfig da base
# mantem HUGETLBFS desligado, entao o hugetlb nunca compilou na arvore).
# CONFIG_CGROUP_HUGETLB is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_HUGETLB_PAGE is not set
# CFS_BANDWIDTH omitido (e desligado explicitamente): kernel/sched/fair.c
# tem backport 5.x quebrado (identificador 'qcfs_rq', label
# 'unthrottle_throttle' inexistente), so compila com CFS_BANDWIDTH
# desligado - como na defconfig da base.
# CONFIG_RT_GROUP_SCHED is not set
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CFQ_GROUP_IOSCHED=y
CONFIG_MEMCG_SWAP_ENABLED=y
# Keys (Docker usa keyrings para encrypted keys)
CONFIG_PERSISTENT_KEYRINGS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
# Rede: diag sockets (ss), checkpoint/restore, fhandle, L3 master, VLAN bridge
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FHANDLE=y
CONFIG_NET_L3_MASTER_DEV=y
CONFIG_VLAN_8021Q=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# Rede: IPVS (LVS), VXLAN, IPVLAN, MACVLAN
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_NETFILTER_XT_MATCH_IPVS=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
CONFIG_VXLAN=y
CONFIG_IPVLAN=y
CONFIG_MACVLAN=y
# Storage (Docker devicemapper thin provisioning)
CONFIG_DM_THIN_PROVISIONING=y

# io_uring (backport v5.1 via patches/io_uring)
CONFIG_IO_URING=y

# Multi-Gen LRU (MGLRU, backport via patches/mglru)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
# (LRU_GEN_STATS precisa do historico total de mm stats; sem MEMCG na base,
#  manter stats ligado so aumenta overhead sem uso pratico no DroidSpaces)

# PSI (Pressure Stall Information): monitor de pressao de memoria usado pelo
# lmkd userspace do Android (A12+). Sem PSI o lmkd fica cego e o Simple LMK
# do kernel (vmpressure) assume: mata apps Android mesmo com MemAvailable alto
# quando o swap/zram esta sob pressao (ex.: container DroidSpaces em uso),
# derrubando camera/Chrome/etc. CONFIG_PSI=y desliga o CONFIG_ANDROID_SIMPLE_LMK
# (Kconfig: depends on !PSI) e o Android volta a decidir kills (comportamento stock).
CONFIG_PSI=y
# CONFIG_ANDROID_SIMPLE_LMK is not set
# (explicito: kills agressivos do kernel; com PSI=y o lmkd userspace assume)

# zram/zswap compression backends (LZ4 + LZ4HC; ZSTD default)
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
# CONFIG_ZSMALLOC_STAT is not set
# (ZSMALLOC_STAT faz 'select DEBUG_FS' -> compila kgsl_debugfs.c, que
#  referencia set_isdb_breakpoint inexistente no struct kgsl_device da base)
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set
# (zram_drv.c da base traz bloco CONFIG_ZRAM_WRITEBACK de 5.x com block API
#  nova - blkdev_get_by_dev/BLK_OPEN_* - que nao existe no 4.19; sem eles o
#  base usa a implementacao 4.19 compativel)
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"

# Device filesystem support
CONFIG_DEVTMPFS=y

# Overlay filesystem support (required for volatile mode)
CONFIG_OVERLAY_FS=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NT synchronization primitives (Wine/Proton) - nativo na base
CONFIG_NTSYNC=y

# binfmt_misc (nativo na base; so falta ligar) - exec transparente de
# binarios de outras ABIs via /proc/sys/fs/binfmt_misc (usado pelo FEX-Emu)
CONFIG_BINFMT_MISC=y

# KernelSU-Next (submodule rsuntk/KernelSU, LSM hooks + manual hooks)
CONFIG_KSU=y

# Firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Droidspaces Network Isolation Support - NAT/none modes
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy compat
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# CONFIG_ANDROID_PARANOID_NETWORK is not set

# DMA-BUF Heaps (SM8250 4.19 uses native ION memory allocator)
# CONFIG_DMABUF_HEAPS is not set

# CMA pool
# CONFIG_CMA_SIZE_MBYTES is not set


# SuSFS - KernelSU Stealth File System (VFS Root Hiding)
# Simbolos validados contra o Kconfig do submodule rsuntk/KernelSU pinado
# (commit 9b28326a, kernel/Kconfig). Os simbolos magic mount abaixo foram
# adicionados pelo patch patches/susfs/51_ksu_susfs_magic_mount.patch
# (aplicado via workflow em KernelSU/kernel/Kconfig). SUS_MAPS/SUS_OVERLAYFS
# nao sao implementados pelo susfs.c do droidspace e ficam desligados.
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_TRY_UMOUNT_FOR_BIND_MOUNT=y

# --- Battery & Energy Efficiency Optimizations ---
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_DEFAULT_SCHEDUTIL=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PM_AUTOSUSPEND=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

