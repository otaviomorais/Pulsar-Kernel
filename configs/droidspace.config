# Kernel configurations for DroidSpaces on the Pulsar base
# (branch staging-bpf, kernel 4.19.404)
# Diferencas vs a config da base:
#   - MGLRU portado para esta base (patches/mglru/0001-mglru.patch),
#     com CONFIG_LRU_GEN y + CONFIG_LRU_GEN_ENABLED y (default ligado em runtime)
#   - zram default compressor via CONFIG_ZRAM_DEF_COMP (mecanismo da base)
# KernelSU-Next (submodule rsuntk/KernelSU), ntsync e BPF a16/a17
# ja sao nativos nesta base.

# IPC mechanisms
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Core namespace support
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y

# Seccomp support
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# Control groups support
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
# MEMCG: habilitado (patches/memcg). O mm/memcontrol.c 4.19 so usa
# memcg->css.cgroup/cgroup_ino() - campos que o graft 5.10 preserva; a quebra
# real do port estava em FAIR_GROUP_SCHED (p->__state) e CGROUP_NET_PRIO
# (css->cgroup->id), corrigidas pelos patches abaixo. Exigido pelo
# CONFIG_DOCKER (LXC/Kosminor) e pelo lmkd userspace (memory.current/max).
CONFIG_MEMCG=y
CONFIG_MEMCG_KMEM=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
# FAIR_GROUP_SCHED: task_change_group_fair() usava p->__state (nome 5.x);
# com o patch 0001 (p->state, TASK_NEW ja existe no sched.h graftado)
# compila. Exigido por CONFIG_DOCKER (LXC) e pela controladora cpu.weight.
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
# CGROUP_NET_PRIO: netprio_cgroup.c usava css->cgroup->id (struct cgroup::id
# removido pelo graft 5.x); o patch 0002 troca para css->id (como o mainline
# v5.6). Exigido por CONFIG_DOCKER (LXC) para net_prio.ifmap.
CONFIG_CGROUP_NET_PRIO=y

# io_uring (backport v5.1 via patches/io_uring)
CONFIG_IO_URING=y

# Multi-Gen LRU (MGLRU, backport via patches/mglru)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
# (LRU_GEN_STATS precisa do historico total de mm stats; sem MEMCG na base,
#  manter stats ligado so aumenta overhead sem uso pratico no DroidSpaces)

# PSI (Pressure Stall Information): monitor de pressao de memoria usado pelo
# lmkd userspace do Android (A12+). Sem PSI o lmkd fica cego e o Simple LMK
# do kernel (vmpressure) assume: mata apps Android mesmo com MemAvailable alto
# quando o swap/zram esta sob pressao (ex.: container DroidSpaces em uso),
# derrubando camera/Chrome/etc. CONFIG_PSI=y desliga o CONFIG_ANDROID_SIMPLE_LMK
# (Kconfig: depends on !PSI) e o Android volta a decidir kills (comportamento stock).
CONFIG_PSI=y
# CONFIG_ANDROID_SIMPLE_LMK is not set
# (explicito: kills agressivos do kernel; com PSI=y o lmkd userspace assume)

# DMA-BUF heaps desabilitados/ausentes nesta base: QTI allocator-service
# detecta /dev/dma_heap e troca o backend de ion -> dma-buf heaps, quebrando
# alocacao YUV (0x17) no video. A base nao tem o driver dma-buf heaps.

# zram/zswap compression backends (LZ4 + LZ4HC; ZSTD default)
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_ZSTD=y
# CONFIG_ZSMALLOC_STAT is not set
# (ZSMALLOC_STAT faz 'select DEBUG_FS' -> compila kgsl_debugfs.c, que
#  referencia set_isdb_breakpoint inexistente no struct kgsl_device da base)
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set
# (zram_drv.c da base traz bloco CONFIG_ZRAM_WRITEBACK de 5.x com block API
#  nova - blkdev_get_by_dev/BLK_OPEN_* - que nao existe no 4.19; sem eles o
#  base usa a implementacao 4.19 compativel)
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"

# Device filesystem support
CONFIG_DEVTMPFS=y

# Overlay filesystem support (required for volatile mode)
CONFIG_OVERLAY_FS=y

# Enable xattr, posix acl support on tmpfs
# For NixOS support
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# NT synchronization primitives (Wine/Proton) - nativo na base
CONFIG_NTSYNC=y

# binfmt_misc (nativo na base; so falta ligar) - exec transparente de
# binarios de outras ABIs via /proc/sys/fs/binfmt_misc (usado pelo FEX-Emu)
CONFIG_BINFMT_MISC=y

# KernelSU-Next (submodule rsuntk/KernelSU, LSM hooks + manual hooks)
CONFIG_KSU=y

# Firmware loading support
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_COMPRESS=y

# Droidspaces Network Isolation Support - NAT/none modes
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# legacy compat
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y

# Disable this on older kernels to make internet work
CONFIG_ANDROID_PARANOID_NETWORK=n

# DMA-BUF heaps (port do Guia Tecnico DMABUF/Gralloc - YUV 0x17 em ROMs A12+)
# system_heap registra "system" + "system-uncached"; cma_heap registra "cma"
# ION continua ON (vem do defconfig: CONFIG_ION=y + ION_SYSTEM_HEAP + ION_POOL_AUTO_REFILL)
# Obs: simbolos QCOM do guia (QCOM_DMABUF_HEAPS, DMABUF_HEAPS_QCOM_*) nao existem
# no 4.19 CAF (verificado via code search) - o port usa o framework generico mainline.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y

# Expand CMA pool to 512MB to prevent camera & GPU allocation failures
CONFIG_CMA_SIZE_MBYTES=512


# SuSFS - KernelSU Stealth File System (VFS Root Hiding)
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_HAS_MAGIC_MOUNT=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAPS=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME-RELEASE=y

# --- Battery & Energy Efficiency Optimizations ---
CONFIG_ENERGY_MODEL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_DEFAULT_SCHEDUTIL=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PM_AUTOSUSPEND=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

