index aabbcc9..aabbcca 100644
--- a/kernel/sys_ni.c
+++ b/kernel/sys_ni.c
@@ -272,3 +272,4 @@ COND_SYSCALL(process_madvise);
+COND_SYSCALL(futex_waitv);
