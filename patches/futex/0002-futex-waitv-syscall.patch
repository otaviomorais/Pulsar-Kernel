+/* ---------------------------------------------------------------
+ * futex_waitv — wait on multiple futexes (backport from Linux 5.16)
+ * --------------------------------------------------------------- */
+
+/**
+ * struct futex_waitv_q - per-futex internal state for futex_waitv
+ * @q:     the futex_q used to queue on the hash bucket
+ * @uaddr: user-space 32-bit futex address
+ * @val:   expected value
+ * @flags: per-waiter flags (FUTEX_32, FUTEX_PRIVATE_FLAG)
+ * @hb:    hash bucket pointer (set by futex_wait_setup)
+ */
+struct futex_waitv_q {
+	struct futex_q            q;
+	u32 __user               *uaddr;
+	u32                       val;
+	unsigned int              flags;
+	struct futex_hash_bucket *hb;
+};
+
+/*
+ * futex_waitv_setup_all() - get_key + queue all waiters
+ *
+ * Iterates the array, calls futex_wait_setup() for each entry.
+ * On value mismatch or error, unqueues already-queued entries and
+ * returns the error.
+ */
+static int futex_waitv_setup_all(struct futex_waitv_q *qv, unsigned int count)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < count; i++) {
+		unsigned int kflags = 0;
+
+		if (!(qv[i].flags & FUTEX_PRIVATE_FLAG))
+			kflags |= FLAGS_SHARED;
+
+		qv[i].q = futex_q_init;
+
+		ret = futex_wait_setup(qv[i].uaddr, qv[i].val, kflags,
+				       &qv[i].q, &qv[i].hb);
+		if (ret) {
+			int j;
+
+			for (j = (int)i - 1; j >= 0; j--)
+				unqueue_me(&qv[j].q);
+			return ret;
+		}
+	}
+	return 0;
+}
+
+/*
+ * futex_waitv_dequeue_all() - unqueue every entry, return index of woken one
+ *
+ * unqueue_me() returns 0 when the task was already removed by a waker
+ * (i.e. we were woken via that futex).  Returns index of woken futex or
+ * -1 if none (timeout / signal path).
+ */
+static int futex_waitv_dequeue_all(struct futex_waitv_q *qv, unsigned int count)
+{
+	unsigned int i;
+	int woken = -1;
+
+	for (i = 0; i < count; i++) {
+		if (!unqueue_me(&qv[i].q) && woken < 0)
+			woken = (int)i;
+	}
+	return woken;
+}
+
+/**
+ * sys_futex_waitv - wait on multiple futexes simultaneously
+ * @uwaitv:    user pointer to array of struct futex_waitv
+ * @nr_futexes: number of entries in the array (1..FUTEX_WAITV_MAX=128)
+ * @flags:     top-level flags: 0 or FUTEX_WAITV_CLOCK_REALTIME
+ * @timeout:   optional absolute timeout as __kernel_timespec; NULL = none
+ * @clockid:   CLOCK_MONOTONIC (default) or CLOCK_REALTIME
+ *
+ * Returns the index (>= 0) of the futex that woke the caller, or a
+ * negative error code (-ETIMEDOUT, -ERESTARTSYS, -EFAULT, -EINVAL…).
+ */
+SYSCALL_DEFINE5(futex_waitv,
+		struct futex_waitv __user *, uwaitv,
+		unsigned int, nr_futexes,
+		unsigned int, flags,
+		struct __kernel_timespec __user *, timeout,
+		clockid_t, clockid)
+{
+	struct hrtimer_sleeper to;
+	bool has_timeout = false;
+	struct futex_waitv_q *qv;
+	struct futex_waitv kv[FUTEX_WAITV_MAX];
+	unsigned int i;
+	int ret;
+
+	/* Validate top-level flags */
+	if (flags & ~FUTEX_WAITV_CLOCK_REALTIME)
+		return -EINVAL;
+	if (!nr_futexes || nr_futexes > FUTEX_WAITV_MAX)
+		return -EINVAL;
+
+	/* Copy userspace array */
+	if (copy_from_user(kv, uwaitv, sizeof(struct futex_waitv) * nr_futexes))
+		return -EFAULT;
+
+	/* Validate per-waiter entries */
+	for (i = 0; i < nr_futexes; i++) {
+		/* __reserved must be zero */
+		if (kv[i].__reserved)
+			return -EINVAL;
+		/* Only FUTEX_32 word size supported; optionally FUTEX_PRIVATE_FLAG */
+		if (!(kv[i].flags & FUTEX_32))
+			return -EINVAL;
+		if (kv[i].flags & ~(FUTEX_32 | FUTEX_PRIVATE_FLAG))
+			return -EINVAL;
+	}
+
+	qv = kcalloc(nr_futexes, sizeof(*qv), GFP_KERNEL);
+	if (!qv)
+		return -ENOMEM;
+
+	for (i = 0; i < nr_futexes; i++) {
+		qv[i].uaddr = (u32 __user *)(uintptr_t)kv[i].uaddr;
+		qv[i].val   = (u32)kv[i].val;
+		qv[i].flags = kv[i].flags;
+	}
+
+	/* Setup optional hrtimer */
+	if (timeout) {
+		struct timespec64 ts;
+		clockid_t clk;
+
+		if (get_timespec64(&ts, timeout)) {
+			ret = -EFAULT;
+			goto out_free;
+		}
+		if (!timespec64_valid(&ts)) {
+			ret = -EINVAL;
+			goto out_free;
+		}
+
+		clk = (flags & FUTEX_WAITV_CLOCK_REALTIME) ?
+		      CLOCK_REALTIME : CLOCK_MONOTONIC;
+
+		hrtimer_init_sleeper_on_stack(&to, clk, HRTIMER_MODE_ABS);
+		hrtimer_set_expires(&to.timer, timespec64_to_ktime(ts));
+		has_timeout = true;
+	}
+
+	/* Queue all entries; bail if any value already differs */
+	ret = futex_waitv_setup_all(qv, nr_futexes);
+	if (ret)
+		goto out_timer;
+
+	/* Go to sleep */
+	set_current_state(TASK_INTERRUPTIBLE);
+
+	if (has_timeout)
+		hrtimer_start_expires(&to.timer, HRTIMER_MODE_ABS);
+
+	/* Check for pending signal before sleeping */
+	if (signal_pending(current)) {
+		__set_current_state(TASK_RUNNING);
+		futex_waitv_dequeue_all(qv, nr_futexes);
+		ret = -ERESTARTSYS;
+		goto out_timer;
+	}
+
+	freezable_schedule();
+	__set_current_state(TASK_RUNNING);
+
+	/* Dequeue and find who woke us */
+	ret = futex_waitv_dequeue_all(qv, nr_futexes);
+	if (ret >= 0)
+		goto out_timer; /* success: ret = woken index */
+
+	/* Woken by timeout or signal */
+	if (has_timeout && !to.task)
+		ret = -ETIMEDOUT;
+	else if (signal_pending(current))
+		ret = -ERESTARTSYS;
+	else
+		ret = -EAGAIN; /* spurious wakeup; caller should retry */
+
+out_timer:
+	if (has_timeout) {
+		hrtimer_cancel(&to.timer);
+		destroy_hrtimer_on_stack(&to.timer);
+	}
+out_free:
+	kfree(qv);
+	return ret;
+}
