diff --git a/kernel/futex.c b/kernel/futex.c
index aabbcc7..aabbcc8 100644
--- a/kernel/futex.c
+++ b/kernel/futex.c
@@ -4195,3 +4195,177 @@ core_initcall(futex_init);
