+int ksu_handle_prctl(int option, unsigned long arg2, unsigned long arg3,
+		     unsigned long arg4, unsigned long arg5)
+{
+	int error = 0;
+
+	if (option != KERNEL_SU_OPTION)
+		return 0;
+
+	if (!only_root())
+		return 1;
+
+	switch (arg2) {
+#ifdef CONFIG_KSU_SUSFS_SUS_PATH
+	case CMD_SUSFS_ADD_SUS_PATH:
+		error = susfs_add_sus_path((void __user *)arg3);
+		break;
+	case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+		susfs_add_sus_path_loop((void __user *)arg3);
+		break;
+	case CMD_SUSFS_SET_ANDROID_DATA_ROOT_PATH:
+		susfs_set_i_state_on_external_dir((void __user *)arg3);
+		break;
+	case CMD_SUSFS_SET_SDCARD_ROOT_PATH:
+		susfs_set_i_state_on_external_dir((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MOUNT
+	case CMD_SUSFS_HIDE_SUS_MNTS_FOR_ALL_PROCS:
+		susfs_set_hide_sus_mnts_for_all_procs((void __user *)arg3);
+		break;
+	case CMD_SUSFS_ADD_SUS_MOUNT:
+		error = susfs_add_sus_mount((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	case CMD_SUSFS_ADD_SUS_KSTAT:
+		error = susfs_add_sus_kstat((void __user *)arg3);
+		break;
+	case CMD_SUSFS_UPDATE_SUS_KSTAT:
+		error = susfs_update_sus_kstat((void __user *)arg3);
+		break;
+	case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+		error = susfs_add_sus_kstat((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	case CMD_SUSFS_ADD_TRY_UMOUNT:
+		error = susfs_add_try_umount((void __user *)arg3);
+		break;
+	case CMD_SUSFS_RUN_UMOUNT_FOR_CURRENT_MNT_NS:
+		{
+			extern void susfs_run_try_umount_for_current_mnt_ns(void);
+			susfs_run_try_umount_for_current_mnt_ns();
+		}
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
+	case CMD_SUSFS_SET_UNAME:
+		error = susfs_set_uname((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_ENABLE_LOG
+	case CMD_SUSFS_ENABLE_LOG:
+		susfs_enable_log((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+	case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+		error = susfs_set_cmdline_or_bootconfig((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_OPEN_REDIRECT
+	case CMD_SUSFS_ADD_OPEN_REDIRECT:
+		error = susfs_add_open_redirect((void __user *)arg3);
+		break;
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+	case CMD_SUSFS_ADD_SUS_MAP:
+		susfs_add_sus_map((void __user *)arg3);
+		break;
+#endif
+	case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+		susfs_set_avc_log_spoofing((void __user *)arg3);
+		break;
+	case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+		susfs_get_enabled_features((void __user *)arg3);
+		break;
+	case CMD_SUSFS_SHOW_VARIANT:
+		susfs_show_variant((void __user *)arg3);
+		break;
+	case CMD_SUSFS_SHOW_VERSION:
+		susfs_show_version((void __user *)arg3);
+		break;
+	}
+
+	if (arg5) {
+		copy_to_user((void __user *)arg5, &error, sizeof(error));
+	}
+
+	return 1;
+}
