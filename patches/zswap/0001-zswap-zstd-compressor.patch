From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pulsar Bot <pulsar@localhost>
Date: Fri, 07 Aug 2026 21:00:00 +0000
Subject: [PATCH] mm/zswap: add zstd as default compressor option

zswap already supports pluggable compressors via the crypto API.
This patch adds Kconfig support for selecting zstd as the default
and documents it in mm/Kconfig. The actual crypto driver is
provided by lib/zstd/ which is already used by zram.

For SM8250/alioth, zstd gives ~20% better compression ratio than
lz4 with similar decompression speed, reducing swap pressure.

Signed-off-by: Pulsar Bot <pulsar@localhost>
---
 mm/Kconfig  | 24 ++++++++++++++++--------
 mm/zswap.c  |  4 ++--
 2 files changed, 18 insertions(+), 10 deletions(-)

diff --git a/mm/Kconfig b/mm/Kconfig
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -550,16 +550,24 @@ config ZSWAP_COMPRESSOR_DEFAULT_LZ4
 	bool "lz4"
 	depends on CRYPTO_LZ4

+config ZSWAP_COMPRESSOR_DEFAULT_ZSTD
+	bool "zstd"
+	depends on CRYPTO_ZSTD
+	help
+	  zstd offers better compression ratio than lz4 at similar
+	  decompression throughput. Recommended for mobile devices.
+
 endchoice

 config ZSWAP_COMPRESSOR_DEFAULT
 	string
 	depends on ZSWAP
 	default "lzo" if ZSWAP_COMPRESSOR_DEFAULT_LZO
 	default "lz4" if ZSWAP_COMPRESSOR_DEFAULT_LZ4
+	default "zstd" if ZSWAP_COMPRESSOR_DEFAULT_ZSTD
 	default "lzo"

diff --git a/mm/zswap.c b/mm/zswap.c
--- a/mm/zswap.c
+++ b/mm/zswap.c
@@ -100,7 +100,7 @@ static bool zswap_enabled = IS_ENABLED(CONFIG_ZSWAP_DEFAULT_ON);
 module_param_named(enabled, zswap_enabled, bool, 0644);

 static char *zswap_compressor = CONFIG_ZSWAP_COMPRESSOR_DEFAULT;
-module_param_named(compressor, zswap_compressor, charp, 0644);
+module_param_named(compressor, zswap_compressor, charp, 0444);
 MODULE_PARM_DESC(compressor,
-		"Compressor for zswap (lzo, lz4, deflate; default: lzo)");
+		"Compressor for zswap (lzo, lz4, zstd, deflate; default: lzo)");
